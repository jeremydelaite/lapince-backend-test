{
	"name": "projet-cda-lapince-backend",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/O-clock-Helsinki/projet-cda-LaPince-backend#readme",
	"bugs": {
		"url": "https://github.com/O-clock-Helsinki/projet-cda-LaPince-backend/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/O-clock-Helsinki/projet-cda-LaPince-backend.git"
	},
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "index.js",
	"directories": {
		"doc": "doc"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "tsx src/server.ts",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"format": "biome format --write ./src",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:unit:coverage": "vitest run --config vitest.unit.config.ts --coverage",
		"test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
		"test:integration:coverage": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts --coverage",
		"test:coverage": "npm run test:unit:coverage && npm run test:integration:coverage",
		"check": "biome check --write ./src",
		"prepare": "husky || true",
		"docker:up": "docker compose -f docker-compose-dev.yml up",
		"docker:down": "docker compose -f docker-compose-dev.yml down",
		"db:migrate": "docker exec lapince-api npx prisma migrate dev",
		"db:seed": "docker exec lapince-api npx prisma db seed",
		"db:reset": "docker exec lapince-api npx prisma migrate reset --force",
		"db:generate": "docker exec lapince-api npx prisma generate",
		"db:seed:remote": "tsx prisma/seed.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-xss-sanitizer": "^2.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"prisma": "^7.8.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"tsx": "^4.22.3",
		"@prisma/client": "^7.8.0",
		"argon2": "^0.44.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"express-xss-sanitizer": "^2.0.2",
		"helmet": "^8.2.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.21.0",
		"swagger-jsdoc": "^6.3.0",
		"swagger-ui-express": "^5.0.1",
		"vitest": "^4.1.7",
		"zod": "^4.4.3"
	}
}
